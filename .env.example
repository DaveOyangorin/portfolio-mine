# Public values are included in the production build. Rebuild after changing them.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_GA4_MEASUREMENT_ID=
# Default: wait for an existing consent manager to grant analytics consent.
# Set false only if your chosen analytics setup does not require opt-in.
PUBLIC_GA4_REQUIRE_CONSENT=true

# Reporting only. Never use PUBLIC_ prefixes for credentials.
GSC_SITE_URL=https://portfolio-mine-theta.vercel.app/
GA4_PROPERTY_ID=
# Store the file outside public/ and src/; use .secrets/ locally.
GOOGLE_APPLICATION_CREDENTIALS=
# Or use GOOGLE_SERVICE_ACCOUNT_JSON as a GitHub Actions secret.

# Optional mobile PageSpeed + CrUX field data; requires a PageSpeed API key.
PAGESPEED_API_KEY=

# Optional AI analysis. Runs only with the report command's --ai flag.
OPENAI_API_KEY=
SEO_AI_MODEL=
