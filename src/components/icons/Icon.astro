---
/**
 * Single inline SVG sprite. Everything is local — no icon CDN requests — which
 * keeps the site fully self-contained and avoids third-party latency.
 */

export type IconName =
  | 'github'
  | 'linkedin'
  | 'facebook'
  | 'mail'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'arrow-up'
  | 'download'
  | 'sun'
  | 'moon'
  | 'menu'
  | 'close'
  | 'map-pin'
  | 'wordpress'
  | 'search'
  | 'code'
  | 'wrench'
  | 'megaphone'
  | 'share';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

// `rest` forwards data-* hooks (used by the header and theme toggle) to the SVG.
const { name, size = 20, class: className = '', ...rest } = Astro.props;

// 24x24 stroke paths, except the brand marks which are filled.
const strokePaths: Partial<Record<IconName, string>> = {
  mail: 'M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M3 7l9 6 9-6',
  'arrow-right': 'M5 12h14 M13 6l6 6-6 6',
  'arrow-up-right': 'M7 17 17 7 M8 7h9v9',
  'arrow-up': 'M12 19V5 M6 11l6-6 6 6',
  download: 'M12 3v12 M7 11l5 5 5-5 M4 19.5h16',
  sun: 'M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10z M12 1v2 M12 21v2 M4.2 4.2l1.4 1.4 M18.4 18.4l1.4 1.4 M1 12h2 M21 12h2 M4.2 19.8l1.4-1.4 M18.4 5.6l1.4-1.4',
  moon: 'M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z',
  menu: 'M4 7h16 M4 12h16 M4 17h16',
  close: 'M6 6l12 12 M18 6L6 18',
  'map-pin': 'M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z M12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  search: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.3-4.3',
  code: 'M8 6l-6 6 6 6 M16 6l6 6-6 6',
  wrench:
    'M14.7 6.3a4 4 0 0 0 5 5l-9.4 9.4a2.8 2.8 0 0 1-4-4z M14.7 6.3 17.5 3.5a1 1 0 0 1 1.4 0l1.6 1.6a1 1 0 0 1 0 1.4L19.7 8',
  megaphone: 'M3 11v2a1 1 0 0 0 1 1h3l7 4V6L7 10H4a1 1 0 0 0-1 1z M18 8a5 5 0 0 1 0 8',
  share: 'M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M8.6 13.5l6.8 4 M15.4 6.5l-6.8 4',
};

const fillPaths: Partial<Record<IconName, string>> = {
  github:
    'M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8 0-.8 0-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.3v3.4c0 .3.2.7.8.6A12 12 0 0 0 12 .5z',
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.57-2.3 3.2V21h-4z',
  wordpress:
    'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM3.6 12a8.4 8.4 0 0 1 .73-3.43l4.02 11A8.4 8.4 0 0 1 3.6 12zm8.4 8.4a8.4 8.4 0 0 1-2.37-.34l2.52-7.32 2.58 7.07a8.4 8.4 0 0 1-2.73.59zm1.16-12.34c.5-.03.96-.08.96-.08.45-.06.4-.72-.05-.7 0 0-1.36.11-2.23.11-.82 0-2.2-.1-2.2-.1-.46-.03-.51.66-.06.69 0 0 .43.05.89.08l1.31 3.6-1.85 5.53-3.07-9.13c.5-.03.96-.08.96-.08.45-.06.4-.72-.05-.7 0 0-1.36.11-2.23.11l-.34-.01A8.4 8.4 0 0 1 18.1 5.6h-.16c-.83 0-1.42.72-1.42 1.5 0 .7.4 1.29.83 1.99.32.57.7 1.3.7 2.35 0 .73-.28 1.58-.65 2.76l-.85 2.84-3.09-9.02zm4.63 11.06 2.57-7.44c.48-1.2.64-2.16.64-3.01 0-.31-.02-.6-.06-.87a8.4 8.4 0 0 1-3.15 11.32z',
  facebook:
    'M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z',
};

const isFilled = name in fillPaths;
---

{
  isFilled ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
      class={className}
      {...rest}
    >
      <path d={fillPaths[name]} />
    </svg>
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class={className}
      {...rest}
    >
      {strokePaths[name]
        ?.split(' M')
        .map((segment, index) => <path d={index === 0 ? segment : `M${segment}`} />)}
    </svg>
  )
}
