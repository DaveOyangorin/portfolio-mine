---
/** Vertical timeline of roles. */
import { experience } from '../../data/experience';
import Section from '../ui/Section.astro';
---

<Section
  id="experience"
  eyebrow="04 — Experience"
  title="Where I've worked"
  subtitle="Six years across agencies and product teams, building and maintaining client websites."
  tone="sunken"
>
  <ol class="relative space-y-8 sm:space-y-10">
    {/* Continuous timeline rail, hidden from assistive tech. */}
    <span
      aria-hidden="true"
      class="absolute left-[7px] top-2 bottom-2 hidden w-px bg-[var(--border-subtle)] sm:block"
    ></span>

    {
      experience.map((entry, index) => (
        <li class="relative sm:pl-12" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
          {/* Timeline node */}
          <span
            aria-hidden="true"
            class="absolute left-0 top-7 hidden h-[15px] w-[15px] rounded-full border-2 border-[var(--accent)] bg-[var(--surface-sunken)] sm:block"
          />

          <article class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface)] p-6 transition-all duration-300 ease-[var(--ease-out-soft)] hover:-translate-y-1 hover:border-[var(--accent)] hover:shadow-[var(--shadow-card-hover)] sm:p-7">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
              <h3 class="text-xl font-medium">{entry.company}</h3>
              <p class="font-mono text-sm text-[var(--accent)]">
                <time datetime={entry.startDate}>{entry.period.split(' – ')[0]}</time>
                {' – '}
                {entry.endDate ? (
                  <time datetime={entry.endDate}>{entry.period.split(' – ')[1]}</time>
                ) : (
                  'Present'
                )}
              </p>
            </div>

            <p class="mt-1.5 text-[var(--text-body)]">{entry.role}</p>
            <p class="mt-1 text-sm text-[var(--text-muted)]">{entry.duration}</p>

            <ul class="mt-4 space-y-2">
              {entry.highlights.map((highlight) => (
                <li class="flex gap-3 text-[var(--text-muted)]">
                  <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--accent)]" />
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</Section>
