---
/** Homepage highlight grid: one strong project per capability, each with a case study. */
import { featuredProjects, projects } from '../../data/projects';
import Section from '../ui/Section.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import Button from '../ui/Button.astro';
import Icon from '../icons/Icon.astro';
---

<Section
  id="work"
  eyebrow="01 — Work"
  title="Selected projects"
  subtitle="Client websites, SEO, CRM automation, and funnels. Each case study states what I personally built or run."
>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      featuredProjects.map((project, index) => (
        <div class="flex" data-reveal data-reveal-scale style={`--reveal-delay: ${(index % 3) * 90}ms`}>
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>

  <div class="mt-12 flex justify-center" data-reveal>
    <Button href="/projects/" variant="secondary" size="lg">
      View all {projects.length} projects
      <Icon name="arrow-right" size={18} />
    </Button>
  </div>
</Section>
