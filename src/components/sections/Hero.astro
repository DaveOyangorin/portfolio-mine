---
/** Above-the-fold hero: roles, headline, statement, CTAs, and portrait. */
import { Image } from 'astro:assets';
import { profile } from '../../data/profile';
import { contact, resume } from '../../data/socials';
import Button from '../ui/Button.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import Icon from '../icons/Icon.astro';

/** Jumps to the contact section while no email address is configured. */
const contactHref = contact.email ? `mailto:${contact.email}` : '#contact';
---

<section id="home" class="relative overflow-hidden scroll-mt-24">
  <!--
    Ambient accent glow. Decorative only.
    Centred with a negative margin (-ml-64, half of w-[32rem]) rather than
    -translate-x-1/2: the parallax tween owns `transform` on this element and
    would overwrite a Tailwind translate class, shunting the glow off-centre.
  -->
  <div
    aria-hidden="true"
    data-hero-glow
    data-parallax="80"
    class="pointer-events-none absolute -top-40 left-1/2 -ml-64 h-[32rem] w-[32rem] rounded-full bg-[var(--color-accent-500)] blur-[120px]"
  >
  </div>

  <div class="container-page relative py-16 sm:py-24 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <div>
        <p
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-4 py-1.5 font-mono text-xs text-[var(--text-muted)]"
          data-hero
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent-400)] opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent-500)]"
            ></span>
          </span>
          Open to remote roles and client projects
        </p>

        <p class="hero-kicker" data-hero>
          {profile.name}
          <span aria-hidden="true" class="text-[var(--accent)]">/</span>
          <span class="text-[var(--text-muted)]">{profile.location}</span>
        </p>

        <!-- data-hero-title (not data-hero): the headline is animated per-letter
             by heroTitle.ts instead of fading up with the rest of the stack.
             Separators are visually hidden so the accessible name reads
             "Web Developer | SEO Specialist | Automation Specialist". -->
        <h1 class="hero-roles" data-hero-title>
          {
            profile.heroRoles.map((role, index) => (
              <>
                {index > 0 && <span class="sr-only"> | </span>}
                <span class="hero-role text-gradient">{role}</span>
              </>
            ))
          }
        </h1>

        <!-- Headline and statement paint immediately (no fade): the statement is the
             mobile LCP element, so gating it on the motion bundle delays LCP. -->
        <p class="hero-headline">
          {profile.heroHeadline}
        </p>

        <p class="mt-4 max-w-xl text-[var(--text-muted)]">
          {profile.heroStatement}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-hero>
          <Button href="#work" size="lg">
            View my projects
            <Icon name="arrow-right" size={18} />
          </Button>

          <Button href={contactHref} variant="secondary" size="lg" external={Boolean(contact.email)}>
            Contact me
          </Button>

          {
            resume.available && (
              <Button href={resume.path} variant="ghost" size="lg" download>
                View resume
                <Icon name="download" size={18} />
              </Button>
            )
          }
        </div>

        <div data-hero>
          <SocialLinks class="mt-9" />
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-sm lg:max-w-none" data-hero-image>
        <div
          class="relative overflow-hidden rounded-3xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-[var(--shadow-card-hover)]"
        >
          <Image
            src={profile.avatar}
            alt={profile.avatarAlt}
            widths={[360, 480, 720]}
            sizes="(max-width: 1024px) 20rem, 26rem"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>

        <!-- Decorative accent frame behind the portrait. -->
        <div
          aria-hidden="true"
          data-hero-frame
          class="absolute -bottom-4 -right-4 -z-10 h-full w-full rounded-3xl border border-[var(--color-accent-500)]"
        >
        </div>
      </div>
    </div>
  </div>
</section>
