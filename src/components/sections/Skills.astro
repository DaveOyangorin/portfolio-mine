---
/**
 * Proficiency meters, one per discipline, each expanding to reveal the tools
 * and capabilities behind it. Bars are scaled to years, so the longest tenure
 * reads 100%.
 *
 * The expand/collapse is the shared GSAP accordion (scripts/motion/skills.ts),
 * driven entirely by the `data-skill-*` hooks below, so nothing section-specific
 * ships to the client.
 */
import { skillLevel, skillMeters } from '../../data/skills';
import Section from '../ui/Section.astro';
---

<Section
  id="skills"
  eyebrow="02 — Skills"
  title="What I work with"
  subtitle="Years of hands-on experience across the disciplines I practise. Open a skill to see the platforms and tools behind it."
  tone="sunken"
>
  <ul class="mx-auto grid max-w-3xl gap-4" data-skill-accordion>
    {
      skillMeters.map((meter, index) => (
        <li
          class="overflow-hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface)] transition-colors duration-300 ease-[var(--ease-out-soft)] hover:border-[var(--accent)]"
          data-reveal
          data-reveal-scale
          style={`--reveal-delay: ${index * 70}ms`}
        >
          {/* Spans, not divs: this is all inside a <button>, which only takes
              phrasing content. */}
          <button
            type="button"
            class="w-full cursor-pointer p-6 text-left focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--accent)]"
            aria-expanded="false"
            aria-controls={`skill-panel-${meter.id}`}
            data-skill-toggle
          >
            <span class="flex items-baseline justify-between gap-3">
              <span class="font-medium text-[var(--text-strong)]">{meter.name}</span>
              <span class="font-mono text-xs whitespace-nowrap text-[var(--text-muted)]">
                {meter.years}
                {meter.suffix} {meter.years === 1 ? 'year' : 'years'}
              </span>
            </span>

            <span class="mt-1.5 block text-sm text-[var(--text-muted)]">
              {meter.description}
            </span>

            {/* Decorative bar — the years are already stated in text above. */}
            <span
              aria-hidden="true"
              class="mt-3 block h-1.5 overflow-hidden rounded-full bg-[var(--surface-sunken)]"
            >
              <span
                class="block h-full rounded-full bg-[var(--accent)] opacity-80"
                style={`width: ${skillLevel(meter)}%`}
              />
            </span>

            <span class="mt-3 flex items-center gap-2 font-mono text-xs text-[var(--text-muted)]">
              {/* Rotated 180° by GSAP while the panel is open. */}
              <svg
                class="size-3.5 text-[var(--accent)]"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                data-skill-icon
              >
                <path d="M4 6l4 4 4-4" />
              </svg>
              Click to view skills
            </span>
          </button>

          <div id={`skill-panel-${meter.id}`} data-skill-panel>
            <ul class="flex flex-wrap gap-2 px-6 pb-6">
              {meter.items.map((item) => (
                <li class="rounded-full border border-[var(--border-subtle)] bg-[var(--surface-sunken)] px-3 py-1 font-mono text-xs text-[var(--text-muted)]">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
