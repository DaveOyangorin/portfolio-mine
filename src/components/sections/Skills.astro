---
/**
 * Skills grouped by category. Static on purpose: every tool is visible without
 * interaction, and nothing is scored with an invented proficiency level.
 */
import { skillGroups } from '../../data/skills';
import Section from '../ui/Section.astro';
---

<Section
  id="skills"
  eyebrow="05 — Skills"
  title="Tools I work with"
  subtitle="From the front end and the CMS to search, tracking, CRM automation, and the AI tools that speed it all up."
  tone="sunken"
>
  <ul class="skill-grid">
    {
      skillGroups.map((group, index) => (
        <li
          class="skill-group"
          data-reveal
          style={`--reveal-delay: ${(index % 3) * 70}ms`}
        >
          <h3 id={`skill-${group.id}`}>{group.name}</h3>
          <p class="mt-1.5 text-sm text-[var(--text-muted)]">{group.description}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-full border border-[var(--border-subtle)] bg-[var(--surface-sunken)] px-3 py-1 font-mono text-xs text-[var(--text-body)]">
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>
