---
import { SITE_URL } from '../../data/site';
import { analytics } from './analyticsConfig';

interface Props { noindex?: boolean }
const enabled = analytics.enabled(Astro.props.noindex);
---

{enabled && <meta name="portfolio-analytics" content={analytics.ga4} data-gtm={analytics.gtm} data-origin={SITE_URL} data-require-consent={String(analytics.requireConsent)} />}

<script>
  import '../../scripts/analytics';
</script>
