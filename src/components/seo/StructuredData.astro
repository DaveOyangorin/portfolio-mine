---
import { getImage } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_LANG, SITE_URL } from '../../data/site';
import { profile } from '../../data/profile';
import { allSkillNames } from '../../data/skills';
import { socials, contact } from '../../data/socials';
import type { Project } from '../../data/types';

interface Props {
  project?: Project;
  title?: string;
  description?: string;
}

const { project, title, description = SITE_DESCRIPTION } = Astro.props;
const homeUrl = new URL('/', SITE_URL).href;
const pageUrl = new URL(`${Astro.url.pathname.replace(/\/$/, '')}/`, SITE_URL).href;
const personId = `${homeUrl}#person`;
const websiteId = `${homeUrl}#website`;
const portrait = await getImage({ src: profile.avatar, width: 480, format: 'webp' });
const artwork = project?.image
  ? await getImage({ src: project.image, width: Math.min(960, project.image.width), format: 'webp' })
  : undefined;

const person = {
  '@type': 'Person', '@id': personId, name: profile.name, jobTitle: profile.title,
  url: homeUrl, image: new URL(portrait.src, SITE_URL).href,
  sameAs: socials.map((social) => social.url),
  ...(contact.email ? { email: `mailto:${contact.email}` } : {}),
  ...(pageUrl === homeUrl ? {
    description: SITE_DESCRIPTION,
    address: { '@type': 'PostalAddress', addressRegion: 'Negros Oriental', addressCountry: 'PH' },
    knowsAbout: allSkillNames,
  } : {}),
};

const page = {
  '@type': project ? 'WebPage' : pageUrl === homeUrl ? 'ProfilePage' : 'CollectionPage',
  '@id': `${pageUrl}#webpage`, url: pageUrl, name: title ?? profile.name,
  description, inLanguage: SITE_LANG, isPartOf: { '@id': websiteId },
  ...(project || pageUrl === homeUrl ? { mainEntity: { '@id': project ? `${pageUrl}#project` : personId } } : {}),
  ...(project ? { breadcrumb: { '@id': `${pageUrl}#breadcrumb` } } : {}),
};

const graph: Record<string, unknown>[] = [person, {
  '@type': 'WebSite', '@id': websiteId, url: homeUrl, name: profile.name,
  description: SITE_DESCRIPTION, publisher: { '@id': personId }, inLanguage: SITE_LANG,
}, page];

if (project) {
  graph.push({
    '@type': 'CreativeWork', '@id': `${pageUrl}#project`, name: project.title,
    description: project.description, url: pageUrl,
    author: { '@id': personId }, creator: { '@id': personId },
    ...(artwork ? { image: new URL(artwork.src, SITE_URL).href } : {}),
  }, {
    '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects/', SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: project.title, item: pageUrl },
    ],
  });
}

const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
  .replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---

<script type="application/ld+json" set:html={json} is:inline />
