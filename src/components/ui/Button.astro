---
/** Anchor styled as a button. Renders <a> so it stays keyboard- and SEO-friendly. */

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** Opens in a new tab with the matching rel attributes. */
  external?: boolean;
  download?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  download = false,
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-xl font-medium transition-all duration-300 ease-[var(--ease-out-soft)] hover:-translate-y-0.5 active:translate-y-0';

const variants = {
  primary:
    'bg-[var(--accent)] text-[var(--accent-contrast)] shadow-[var(--shadow-card)] hover:shadow-[0_0_40px_-6px_var(--color-accent-500)]',
  secondary:
    'border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-[var(--text-strong)] hover:border-[var(--accent)] hover:text-[var(--accent)]',
  ghost:
    'text-[var(--text-body)] hover:bg-[var(--surface-raised)] hover:text-[var(--accent)]',
} as const;

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-6 py-3.5 text-base',
} as const;
---

<a
  href={href}
  class:list={[base, variants[variant], sizes[size], className]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  {...download ? { download: '' } : {}}
  {...rest}
>
  <slot />
</a>
