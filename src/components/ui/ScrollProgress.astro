---
/** Thin reading-progress bar pinned to the top of the viewport. */
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-0.5 bg-transparent"
>
  <div
    data-scroll-progress
    class="h-full origin-left bg-[var(--accent)] transition-transform duration-150 ease-out"
    style="transform: scaleX(0)"
  >
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-scroll-progress]');

  if (bar) {
    let ticking = false;

    const update = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
      bar.style.transform = `scaleX(${Math.min(progress, 1)})`;
      ticking = false;
    };

    // rAF-throttled so scrolling stays off the critical path.
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
