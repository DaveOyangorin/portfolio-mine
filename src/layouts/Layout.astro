---
/** Base document shell: head, header, footer, and the global UI scripts. */
/* Route Board type: Archivo (weight + width axes) for reading and route
   plates, Bungee for the signwritten display caps. Both self-hosted. */
import '@fontsource-variable/archivo/standard.css';
import '@fontsource/bungee/400.css';
import archivoFont from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import bungeeFont from '@fontsource/bungee/files/bungee-latin-400-normal.woff2?url';
import '../styles/global.css';

import { SITE_LANG } from '../data/site';
import BaseHead from '../components/seo/BaseHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import Analytics from '../components/seo/Analytics.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ScrollProgress from '../components/ui/ScrollProgress.astro';
import BackToTop from '../components/ui/BackToTop.astro';
import type { Project } from '../data/types';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** Passed through to StructuredData for project detail pages. */
  project?: Project;
}

const { title, description, image, type, noindex, project } = Astro.props;
---

<!doctype html>
<html lang={SITE_LANG} data-theme="light" class="no-js">
  <head>
    <link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={bungeeFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
    />
    {!noindex && <StructuredData project={project} title={title} description={description} />}
    <Analytics noindex={noindex} />

    <!--
      Applied before first paint so the stored theme never flashes.
      Inline and blocking by design; it is only a few hundred bytes.

      Light is the default for everyone, regardless of the OS colour scheme.
      Dark applies only after a visitor picks it with the toggle. The key is
      'theme-choice' (not the old 'theme') so dark choices saved before light
      became the default are discarded.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.remove('no-js');
        try {
          root.dataset.theme = localStorage.getItem('theme-choice') === 'dark' ? 'dark' : 'light';
          localStorage.removeItem('theme');
        } catch (e) {
          /* localStorage blocked — keep the default light theme. */
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--surface)]">
    <!-- Skip link: first tab stop on every page. -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-[var(--accent)] focus:px-4 focus:py-2 focus:font-medium focus:text-[var(--accent-contrast)]"
    >
      Skip to main content
    </a>

    <ScrollProgress />
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <BackToTop />

    <!--
      All motion (reveals, hero intro, header, counters, parallax) lives in
      src/scripts/motion. Astro bundles and defers this, so GSAP never blocks
      first paint.
    -->
    <script>
      import '../scripts/motion';
    </script>

    <style is:global>
      /* Without JS the reveal observer never runs, so show everything upfront. */
      .no-js [data-reveal],
      .no-js [data-hero],
      .no-js [data-hero-image],
      .no-js [data-header] {
        opacity: 1;
        transform: none;
      }

      /* No JS, no filtering: hide the dead control. */
      .no-js [data-filter-bar] {
        display: none;
      }

      .no-js [data-hero-glow] {
        opacity: 0;
      }

      .no-js [data-hero-frame] {
        opacity: 1;
      }
    </style>
  </body>
</html>
