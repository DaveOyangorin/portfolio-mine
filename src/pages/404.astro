---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/icons/Icon.astro';
---

<Layout title="Page not found" description="That page could not be found." noindex>
  <div class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-6xl font-medium text-[var(--accent)] sm:text-7xl">404</p>
    <h1 class="mt-6 text-3xl font-medium sm:text-4xl">This page doesn't exist</h1>
    <p class="mt-4 max-w-md text-lg text-[var(--text-muted)]">
      The link may be out of date, or the page may have moved.
    </p>

    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <Button href="/" size="lg">
        Back to home
        <Icon name="arrow-right" size={18} />
      </Button>
      <Button href="/projects" variant="secondary" size="lg">Browse projects</Button>
    </div>
  </div>
</Layout>
