---
/** Static project detail page. Slugs mirror the previous site's URLs. */
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import ProjectPlaceholder from '../../components/ui/ProjectPlaceholder.astro';
import Icon from '../../components/icons/Icon.astro';
import { projects } from '../../data/projects';

export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;

const { project } = Astro.props;

// Neighbouring projects power the prev/next footer links.
const index = projects.findIndex((item) => item.slug === project.slug);
const previous = index > 0 ? projects[index - 1] : null;
const next = index < projects.length - 1 ? projects[index + 1] : null;
---

<Layout
  title={project.title}
  description={project.description.slice(0, 160)}
  image={project.image?.src}
  type="article"
  project={project}
>
  <article class="container-page py-12 sm:py-16">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-10">
      <ol class="flex flex-wrap items-center gap-2 font-mono text-sm text-[var(--text-muted)]">
        <li><a href="/" class="transition-colors hover:text-[var(--accent)]">Home</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/projects" class="transition-colors hover:text-[var(--accent)]">Projects</a>
        </li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="page" class="text-[var(--text-strong)]">{project.title}</span></li>
      </ol>
    </nav>

    <div class="grid gap-12 lg:grid-cols-[1fr_22rem] lg:gap-16">
      <div>
        <header data-reveal>
          <h1 class="text-3xl font-medium sm:text-4xl">{project.title}</h1>
          <p class="mt-6 text-lg text-[var(--text-body)]">
            {project.description}
          </p>
        </header>

        {/* Contained on a fixed-tone plate — see the note in ProjectCard.astro. */}
        <div
          class:list={[
            'mt-10 flex aspect-[16/9] items-center justify-center overflow-hidden rounded-2xl border border-[var(--border-subtle)] p-10 sm:p-14',
            project.image
              ? project.imageTone === 'dark'
                ? 'bg-[#12151c]'
                : 'bg-white'
              : 'bg-[var(--surface-sunken)]',
          ]}
          data-reveal
          style="--reveal-delay: 80ms"
        >
          {
            project.image ? (
              <Image
                src={project.image}
                alt={project.title}
                widths={[640, 960, 1280]}
                sizes="(max-width: 1024px) 100vw, 48rem"
                loading="eager"
                fetchpriority="high"
                class="max-h-full w-auto max-w-full object-contain"
              />
            ) : (
              <ProjectPlaceholder title={project.title} class="rounded-xl" />
            )
          }
        </div>
      </div>

      <!-- Sidebar: tech stack and links -->
      <aside class="lg:sticky lg:top-28 lg:self-start" data-reveal style="--reveal-delay: 120ms">
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          {
            project.tags.length > 0 && (
              <>
                <h2 class="font-mono text-sm text-[var(--accent)] uppercase">
                  Tech stack
                </h2>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <li class="rounded-full border border-[var(--border-subtle)] bg-[var(--surface)] px-3 py-1.5 font-mono text-xs text-[var(--text-body)]">
                      {tag}
                    </li>
                  ))}
                </ul>
              </>
            )
          }

          <div class="mt-6 flex flex-col gap-3">
            <Button href={project.liveUrl} external size="lg">
              Visit live site
              <Icon name="arrow-up-right" size={18} />
            </Button>

            {
              project.repoUrl && (
                <Button href={project.repoUrl} variant="secondary" size="lg" external>
                  <Icon name="github" size={18} />
                  View source
                </Button>
              )
            }

            <Button href="/projects" variant="ghost">
              Back to all projects
            </Button>
          </div>
        </div>
      </aside>
    </div>

    <!-- Prev / next -->
    <nav
      aria-label="More projects"
      class="mt-16 grid gap-4 border-t border-[var(--border-subtle)] pt-8 sm:grid-cols-2"
    >
      {
        previous ? (
          <a
            href={`/projects/${previous.slug}/`}
            class="group rounded-2xl border border-[var(--border-subtle)] p-5 transition-all duration-300 ease-[var(--ease-out-soft)] hover:border-[var(--accent)]"
          >
            <span class="font-mono text-xs text-[var(--text-muted)]">Previous</span>
            <span class="mt-1 block font-medium transition-colors group-hover:text-[var(--accent)]">
              {previous.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }

      {
        next && (
          <a
            href={`/projects/${next.slug}/`}
            class="group rounded-2xl border border-[var(--border-subtle)] p-5 text-right transition-all duration-300 ease-[var(--ease-out-soft)] hover:border-[var(--accent)] sm:col-start-2"
          >
            <span class="font-mono text-xs text-[var(--text-muted)]">Next</span>
            <span class="mt-1 block font-medium transition-colors group-hover:text-[var(--accent)]">
              {next.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>
</Layout>
