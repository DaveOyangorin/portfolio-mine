---
/** Full project index with client-side filtering by tech tag. */
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import { projects } from '../../data/projects';

/** Every distinct tag across all projects, alphabetised, for the filter bar. */
const allTags = [...new Set(projects.flatMap((project) => project.tags))].sort((a, b) =>
  a.localeCompare(b),
);
---

<Layout
  title="Projects"
  description="Client websites designed, built, and maintained by Dave Oyangorin — WordPress, Elementor, Divi, Duda, and front-end builds with ongoing SEO."
>
  <div class="container-page py-16 sm:py-20">
    <header class="max-w-2xl" data-reveal>
      <p class="mb-3 font-mono text-sm text-[var(--accent)] uppercase">
        Portfolio
      </p>
      <h1 class="text-3xl font-medium sm:text-4xl">Projects</h1>
      <p class="mt-5 text-lg text-[var(--text-muted)]">
        {projects.length} client websites — built, rebuilt, and maintained. Filter by the
        technology behind each one.
      </p>
    </header>

    <!-- Filter bar. Enhancement only: without JS every project stays visible. -->
    <div class="mt-10" data-reveal>
      <h2 id="filter-heading" class="sr-only">Filter projects by technology</h2>
      <div
        class="flex flex-wrap gap-2"
        role="group"
        aria-labelledby="filter-heading"
        data-filter-bar
        hidden
      >
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="rounded-full border border-[var(--border-subtle)] px-4 py-2 font-mono text-xs transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)] aria-pressed:border-[var(--accent)] aria-pressed:bg-[var(--accent)] aria-pressed:text-[var(--accent-contrast)]"
        >
          All
        </button>
        {
          allTags.map((tag) => (
            <button
              type="button"
              data-filter={tag}
              aria-pressed="false"
              class="rounded-full border border-[var(--border-subtle)] px-4 py-2 font-mono text-xs transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)] aria-pressed:border-[var(--accent)] aria-pressed:bg-[var(--accent)] aria-pressed:text-[var(--accent-contrast)]"
            >
              {tag}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Announces filter results to screen readers. -->
    <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-project-grid>
      {
        projects.map((project, index) => (
          <div
            data-reveal
            data-project-tags={project.tags.join('|')}
            style={`--reveal-delay: ${(index % 3) * 80}ms`}
          >
            <ProjectCard project={project} eager={index < 3} maxTags={4} />
          </div>
        ))
      }
    </div>

    <p class="mt-12 hidden text-center text-[var(--text-muted)]" data-empty-state>
      No projects match that filter.
    </p>
  </div>
</Layout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

  if (bar && grid) {
    // Revealed only once the script runs, so no-JS users never see a dead control.
    bar.hidden = false;

    const buttons = bar.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = grid.querySelectorAll<HTMLElement>('[data-project-tags]');

    const applyFilter = (filter: string) => {
      let visible = 0;

      items.forEach((item) => {
        const tags = (item.dataset.projectTags ?? '').split('|');
        const matches = filter === 'all' || tags.includes(filter);
        item.hidden = !matches;
        if (matches) visible += 1;
      });

      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      });

      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);

      if (status) {
        status.textContent =
          filter === 'all'
            ? `Showing all ${visible} projects.`
            : `Showing ${visible} ${visible === 1 ? 'project' : 'projects'} tagged ${filter}.`;
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all'));
    });
  }
</script>
